# V-FEED [06] environment
PORT=3000

# Optional — YouTube Data API v3
YOUTUBE_API_KEY=
YOUTUBE_PLAYLIST_ID=
YOUTUBE_SEARCH_QUERY=classic cinema 80s 90s movie scene tv #shorts
YOUTUBE_MAX_VIDEOS=10
YOUTUBE_AUTO_SYNC=true
YOUTUBE_CACHE_TTL_MINUTES=360
YOUTUBE_DAILY_QUOTA_LIMIT=9000

# Storage Guard configuration (fallback videos folder limits)
FALLBACK_MAX_STORAGE_MB=500
FALLBACK_MAX_VIDEOS=60
FALLBACK_PRUNE_THRESHOLD_RATIO=0.80
FALLBACK_PROTECT_LOCAL=true

# Storage Replenishment & Watermark settings
FALLBACK_MIN_REPLENISH_VIDEOS=20
FALLBACK_AUTO_REPLENISH=true
FALLBACK_REPLENISH_COOLDOWN_MINUTES=30
FALLBACK_TRICKLE_HOURS=3
